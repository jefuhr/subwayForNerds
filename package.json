{
  "name": "subways-for-nerds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k 'tsx watch server/index.ts' 'vite --host 0.0.0.0'",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test",
    "test:native": "bash scripts/test-native.sh",
    "test:ios": "bash scripts/test-ios.sh",
    "fixtures:native": "tsx scripts/export-native-fixtures.ts",
    "check": "npm run build && npm test",
    "fleet:db": "node scripts/fleet-db.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "^10.1.3",
    "csv-parse": "^6.0.0",
    "fastify": "^5.0.0",
    "fflate": "^0.8.2",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "protobufjs": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.0.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
